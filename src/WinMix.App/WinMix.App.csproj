<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinMix</AssemblyName>
    <RootNamespace>WinMix.App</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- WFAC010 tells WinForms apps to set DPI mode in code instead of the
         manifest. This is a WPF app that only references WinForms for the tray
         icon, and for WPF the manifest is the correct place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinMix.Audio\WinMix.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not just referenced by ApplicationIcon) so the WPF window
         and the tray NotifyIcon can both load it at runtime via a pack URI,
         rather than depending on a loose file next to the exe. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
