<Window x:Class="WinMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinMix.App.ViewModels"
        Title="WinMix"
        Icon="Assets/AppIcon.ico"
        SizeToContent="Width"
        Height="420"
        MinWidth="300"
        MinHeight="360"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MixerViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Output"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource MixComboBoxStyle}"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                          DisplayMemberPath="FriendlyName"
                          MinWidth="150"
                          ToolTip="Output device" />

                <TextBlock Text="Input"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox Style="{StaticResource MixComboBoxStyle}"
                          ItemsSource="{Binding InputDevices}"
                          SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                          DisplayMemberPath="FriendlyName"
                          MinWidth="150"
                          ToolTip="Input device (microphone)" />
            </StackPanel>
        </StackPanel>

        <!-- Surfaced only when the audio stack itself is unavailable -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"
                   Foreground="#FFFFB4A2"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="2,0,2,8" />

        <!-- Channel strips: the device master fader first, then one per app,
             side by side like the native Windows volume mixer. -->
        <ScrollViewer x:Name="StripsScroll"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="0,0,0,6">
            <StackPanel Orientation="Horizontal">

                <!-- Device strip -->
                <Border Width="64"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,10"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="&#x1F50A;"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />

                        <Slider Grid.Row="1"
                                Style="{StaticResource MixSliderVerticalStyle}"
                                Value="{Binding MasterPosition, Mode=TwoWay}"
                                HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding MasterPercent, StringFormat={}{0}%}"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />

                        <ToggleButton Grid.Row="3"
                                      Style="{StaticResource MuteToggleStyle}"
                                      IsChecked="{Binding MasterMuted, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      Margin="0,2,0,0" />

                        <TextBlock Grid.Row="4"
                                   Text="Device"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- App strips -->
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                            <Border Width="64"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,10"
                                    Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <!-- Idle apps stay listed but recede, so a strip
                                                 does not vanish the instant playback pauses. -->
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0"
                                           Source="{Binding Icon}"
                                           Width="20"
                                           Height="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <Slider Grid.Row="1"
                                            Style="{StaticResource MixSliderVerticalStyle}"
                                            Value="{Binding SliderPosition, Mode=TwoWay}"
                                            HorizontalAlignment="Center" />

                                    <ProgressBar Grid.Row="2"
                                                 Style="{StaticResource MeterStyle}"
                                                 Value="{Binding PeakLevel, Mode=OneWay}"
                                                 Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding VolumePercent, StringFormat={}{0}%}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />

                                    <ToggleButton Grid.Row="4"
                                                  Style="{StaticResource MuteToggleStyle}"
                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,2,0,0" />

                                    <ComboBox Grid.Row="5"
                                              Style="{StaticResource MixComboBoxStyle}"
                                              ItemsSource="{Binding OutputOptions}"
                                              SelectedItem="{Binding SelectedOutputOption, Mode=TwoWay}"
                                              DisplayMemberPath="FriendlyName"
                                              FontSize="9"
                                              Padding="4,3"
                                              Width="52"
                                              ToolTip="Output device"
                                              Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="6"
                                               Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="10"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No applications are playing audio."
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
